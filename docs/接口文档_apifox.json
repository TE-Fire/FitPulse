{
  "openapi": "3.0.3",
  "info": {
    "title": "FitPulse API",
    "version": "1.1.0",
    "description": "FitPulse 个人健康健身后端（单体 Spring Boot 3.2.5 + JDK 21）。本文档仅包含已开发或本次计划开发的接口，未实现模块（看板/训练/健康/AI）暂未列入。"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "本地后端（单体默认 8080）"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "认证：注册/登录/刷新/登出"
    },
    {
      "name": "User",
      "description": "个人中心：资料/账号/密码/头像/训练统计/健康概览"
    },
    {
      "name": "File",
      "description": "文件上传（本地存储降级，个人版无需 MinIO）"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "POST /auth/login 获取 accessToken。Authorization: Bearer {token}"
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "required": [
          "code",
          "message",
          "timestamp"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "操作成功"
          },
          "data": {
            "nullable": true
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "example": 1755410000000
          }
        }
      },
      "LoginUserVO": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "RegisterReq": {
        "type": "object",
        "required": [
          "email",
          "password",
          "code"
        ],
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@]+@qq\\.com$",
            "description": "必须以 @qq.com 结尾"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "description": "至少包含字母和数字"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "注册验证码（先调 /auth/register/send-code，5min 内有效）"
          }
        },
        "example": {
          "email": "fire_dev@qq.com",
          "password": "Fire@2026",
          "code": "482917"
        }
      },
      "LoginReq": {
        "type": "object",
        "required": [
          "email",
          "type"
        ],
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@]+@qq\\.com$",
            "description": "QQ 邮箱"
          },
          "type": {
            "type": "integer",
            "format": "int32",
            "enum": [
              1,
              2
            ],
            "description": "1=密码登录 2=验证码登录"
          },
          "password": {
            "type": "string",
            "nullable": true,
            "description": "仅 type=1 时必填，8-64位"
          },
          "code": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{6}$",
            "description": "仅 type=2 时必填，6位数字"
          }
        },
        "example": {
          "email": "fire_dev@qq.com",
          "type": 1,
          "password": "Fire@2026"
        }
      },
      "RegisterSendCodeReq": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@]+@qq\\.com$",
            "description": "接收注册验证码的 QQ 邮箱"
          }
        },
        "example": {
          "email": "fire_dev@qq.com"
        }
      },
      "SendCodeReq": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@]+@qq\\.com$",
            "description": "接收登录验证码的 QQ 邮箱"
          }
        },
        "example": {
          "email": "fire_dev@qq.com"
        }
      },
      "SendCodeResp": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "6位验证码明文，与控制台日志、邮件正文、Redis存储值一致（本地/演示环境返回）"
          },
          "expireMinutes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "验证码有效期（分钟）"
          },
          "rateLimitSeconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "同邮箱发送频率限制（秒），超过此间隔前重复发送会返回409防刷"
          }
        },
        "example": {
          "code": "482917",
          "expireMinutes": 5,
          "rateLimitSeconds": 60
        }
      },
      "ForgotPasswordSendCodeReq": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@]+@qq\\.com$",
            "description": "已注册的 QQ 邮箱（发送密码重置验证码）"
          }
        },
        "example": {
          "email": "fire_dev@qq.com"
        }
      },
      "ForgotPasswordResetReq": {
        "type": "object",
        "required": [
          "email",
          "code",
          "newPassword",
          "confirmPassword"
        ],
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@]+@qq\\.com$",
            "description": "QQ 邮箱"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "密码重置验证码（先调 /auth/forgot-password/send-code 获取）"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).{8,}$",
            "description": "新密码（8-64位，需同时包含字母和数字）"
          },
          "confirmPassword": {
            "type": "string",
            "description": "确认新密码（必须与 newPassword 一致）"
          }
        },
        "example": {
          "email": "fire_dev@qq.com",
          "code": "730125",
          "newPassword": "Fire@2026",
          "confirmPassword": "Fire@2026"
        }
      },
      "RefreshReq": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "登录下发的 refreshToken"
          }
        },
        "example": {
          "refreshToken": "eyJhbGciOiJIUzI1NiJ9..."
        }
      },
      "UserProfileVO": {
        "type": "object",
        "description": "用户完整资料（聚合 user + user_profile）",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "description": "用户 ID"
          },
          "username": {
            "type": "string",
            "description": "用户名（只读）"
          },
          "email": {
            "type": "string",
            "description": "邮箱"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "手机号"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "1=启用 0=禁用"
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true,
            "description": "最后登录时间 yyyy-MM-dd HH:mm:ss"
          },
          "createdAt": {
            "type": "string",
            "description": "注册时间 yyyy-MM-dd HH:mm:ss"
          },
          "profile": {
            "type": "object",
            "description": "用户资料（user_profile 表，V2 新增字段已标注）",
            "properties": {
              "nickname": {
                "type": "string",
                "nullable": true,
                "description": "昵称"
              },
              "avatarUrl": {
                "type": "string",
                "nullable": true,
                "description": "头像文件 URL"
              },
              "gender": {
                "type": "integer",
                "format": "int32",
                "nullable": true,
                "description": "0=未知 1=男 2=女"
              },
              "birthday": {
                "type": "string",
                "format": "date",
                "nullable": true,
                "description": "生日 yyyy-MM-dd"
              },
              "heightCm": {
                "type": "number",
                "nullable": true,
                "description": "身高 cm"
              },
              "weightKg": {
                "type": "number",
                "nullable": true,
                "description": "【V2新增】当前体重 kg（缓存最新值）"
              },
              "bodyFatPct": {
                "type": "number",
                "nullable": true,
                "description": "【V2新增】当前体脂率 %（缓存最新值）"
              },
              "fitnessLevel": {
                "type": "integer",
                "format": "int32",
                "nullable": true,
                "description": "【V2新增】1=入门 2=进阶 3=达人 4=专业"
              },
              "theme": {
                "type": "integer",
                "format": "int32",
                "nullable": true,
                "description": "【V2新增】1=浅色 2=深色 3=跟随系统"
              },
              "bio": {
                "type": "string",
                "nullable": true,
                "description": "个人简介"
              }
            }
          }
        },
        "example": {
          "userId": 1873487291038476288,
          "username": "fire_dev",
          "email": "fire_dev@qq.com",
          "phone": "13800008888",
          "status": 1,
          "lastLoginAt": "2026-08-19 09:30:15",
          "createdAt": "2026-01-15 10:00:00",
          "profile": {
            "nickname": "Fire健身达人",
            "avatarUrl": "/files/avatar/20260819/abc123.jpg",
            "gender": 1,
            "birthday": "1998-05-20",
            "heightCm": 175.0,
            "weightKg": 72.5,
            "bodyFatPct": 18.2,
            "fitnessLevel": 3,
            "theme": 1,
            "bio": "坚持健身3年，目标是80kg卧推"
          }
        }
      },
      "UpdateProfileReq": {
        "type": "object",
        "description": "更新基本资料（仅 user_profile 表字段，部分更新语义）",
        "properties": {
          "nickname": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "昵称"
          },
          "gender": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "enum": [
              0,
              1,
              2
            ],
            "description": "0=未知 1=男 2=女"
          },
          "birthday": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "生日 yyyy-MM-dd"
          },
          "heightCm": {
            "type": "number",
            "nullable": true,
            "minimum": 50,
            "maximum": 300,
            "description": "身高 cm"
          },
          "weightKg": {
            "type": "number",
            "nullable": true,
            "minimum": 20,
            "maximum": 500,
            "description": "当前体重 kg"
          },
          "bodyFatPct": {
            "type": "number",
            "nullable": true,
            "minimum": 3,
            "maximum": 60,
            "description": "当前体脂率 %"
          },
          "fitnessLevel": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1=入门 2=进阶 3=达人 4=专业"
          },
          "theme": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "enum": [
              1,
              2,
              3
            ],
            "description": "1=浅色 2=深色 3=跟随系统"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 512,
            "description": "个人简介"
          }
        },
        "example": {
          "nickname": "Fire健身达人",
          "gender": 1,
          "birthday": "1998-05-20",
          "heightCm": 175.0,
          "weightKg": 72.5,
          "bodyFatPct": 18.2,
          "fitnessLevel": 3,
          "theme": 1,
          "bio": "坚持健身3年，目标是80kg卧推"
        }
      },
      "UpdateAccountReq": {
        "type": "object",
        "description": "更新账号信息（仅 user 表的 email / phone 字段）",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true,
            "pattern": "^[^@]+@qq\\.com$",
            "description": "新邮箱（变更时检查唯一性）"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{11}$",
            "description": "新手机号（11位数字）"
          }
        },
        "example": {
          "email": "new_fire@qq.com",
          "phone": "13900001111"
        }
      },
      "ChangePasswordReq": {
        "type": "object",
        "required": [
          "oldPassword",
          "newPassword",
          "confirmPassword"
        ],
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "当前密码明文"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).{8,}$",
            "description": "新密码（8-64位，需同时包含字母和数字）"
          },
          "confirmPassword": {
            "type": "string",
            "description": "确认新密码（必须与 newPassword 一致）"
          }
        },
        "example": {
          "oldPassword": "Fire@2026",
          "newPassword": "Fire@2027",
          "confirmPassword": "Fire@2027"
        }
      },
      "AvatarUploadVO": {
        "type": "object",
        "properties": {
          "avatarUrl": {
            "type": "string",
            "description": "头像可访问 URL"
          }
        },
        "example": {
          "avatarUrl": "/files/avatar/20260819/abc123.jpg"
        }
      },
      "TrainingStatsVO": {
        "type": "object",
        "description": "训练统计概览（聚合 workout_record 表）",
        "properties": {
          "totalWorkouts": {
            "type": "integer",
            "format": "int32",
            "description": "累计训练次数"
          },
          "totalVolume": {
            "type": "number",
            "description": "累计训练容量 kg"
          },
          "streakDays": {
            "type": "integer",
            "format": "int32",
            "description": "当前连续训练天数"
          },
          "lastWorkoutAt": {
            "type": "string",
            "nullable": true,
            "description": "最近一次训练时间 yyyy-MM-dd"
          }
        },
        "example": {
          "totalWorkouts": 128,
          "totalVolume": 56820.00,
          "streakDays": 7,
          "lastWorkoutAt": "2026-08-18"
        }
      },
      "HealthOverviewVO": {
        "type": "object",
        "description": "健康概览（聚合 body_metric + meal_record + water_log 表）",
        "properties": {
          "latestWeight": {
            "type": "number",
            "nullable": true,
            "description": "最新体重 kg（最近一条 body_metric）"
          },
          "latestBodyFat": {
            "type": "number",
            "nullable": true,
            "description": "最新体脂率 %"
          },
          "caloriesToday": {
            "type": "number",
            "nullable": true,
            "description": "今日已摄入 kcal"
          },
          "waterTodayMl": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "今日饮水 ml"
          }
        },
        "example": {
          "latestWeight": 72.5,
          "latestBodyFat": 18.2,
          "caloriesToday": 1450.0,
          "waterTodayMl": 1200
        }
      },
      "FileUploadVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "文件资源 ID"
          },
          "fileUrl": {
            "type": "string",
            "description": "可直接访问 URL（本地降级=/files/<bucket>/...）"
          }
        },
        "example": {
          "id": 1873487291038476300,
          "fileUrl": "/files/avatar/20260819/abc123.jpg"
        }
      }
    }
  },
  "paths": {
    "/auth/register/send-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "发送注册验证码到QQ邮箱（6位数字，5min有效，60s防刷，与登录验证码前缀独立）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterSendCodeReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发送注册验证码成功，data返回验证码明文与过期/限流元信息",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Result"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SendCodeResp"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "操作成功",
                  "data": {
                    "code": "482917",
                    "expireMinutes": 5,
                    "rateLimitSeconds": 60
                  },
                  "timestamp": 1755410000000
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "注册（QQ邮箱+注册验证码，username后端自动生成）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterReq"
              },
              "example": {
                "email": "fire_dev@qq.com",
                "password": "Fire@2026",
                "code": "482917"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功(data=null)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "code": 200,
                  "message": "操作成功",
                  "data": null,
                  "timestamp": 1755410000000
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "登录（type=1密码 / type=2验证码）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginReq"
              },
              "examples": {
                "passwordLogin": {
                  "summary": "密码登录（type=1，不需要code）",
                  "value": {
                    "email": "fire_dev@qq.com",
                    "type": 1,
                    "password": "Fire@2026"
                  }
                },
                "codeLogin": {
                  "summary": "验证码登录（type=2，需要先发 login/send-code 拿 code）",
                  "value": {
                    "email": "fire_dev@qq.com",
                    "type": 2,
                    "code": "952764"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功，返回 Token 对 + 用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Result"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LoginUserVO"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/login/send-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "发送登录验证码到QQ邮箱（6位数字，5min有效，与注册验证码前缀独立互不相通）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCodeReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发送登录验证码成功，data返回验证码明文与过期/限流元信息",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Result"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SendCodeResp"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "操作成功",
                  "data": {
                    "code": "952764",
                    "expireMinutes": 5,
                    "rateLimitSeconds": 60
                  },
                  "timestamp": 1755410000000
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "刷新 Token 对（用 refreshToken，旋转失效旧的）",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
